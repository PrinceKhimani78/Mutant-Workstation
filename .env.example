# Supabase → Project Settings → Database → Connection string gives you both of
# these. Unlike Vercel's native Postgres storage, Supabase env vars are NOT
# auto-injected — add both manually in Vercel → Settings → Environment Variables.

# Pooled connection (PgBouncer, port 6543) — what the app uses at runtime.
# Append ?pgbouncer=true so Prisma disables features PgBouncer's transaction
# mode doesn't support.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used only for schema changes (prisma db push).
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# Secret used to sign login JWTs. Falls back to an insecure default in src/lib/auth.ts
# if unset — set a real value in production.
JWT_SECRET="change-me-to-a-long-random-string"
