# Supabase → Project → Connect → copy both of these in (not auto-injected into
# Vercel the way Vercel's own Postgres storage would be — add manually under
# Settings → Environment Variables).

# Pooled connection (Supavisor/PgBouncer, port 6543) — used for app queries.
# Append ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used only for schema changes (prisma db push).
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Secret used to sign login JWTs. Falls back to an insecure default in src/lib/auth.ts
# if unset — set a real value in production.
JWT_SECRET="change-me-to-a-long-random-string"

# OpenRouter API key powering the AI assistant. Without it, the assistant still
# works but only via its built-in canned-response fallback (no live LLM calls).
# Get one at openrouter.ai/keys. Never hardcode this in source — env var only.
OPENROUTER_API_KEY="sk-or-v1-..."
