# Postgres connection string. On Vercel this is injected automatically once you
# connect a Postgres database to the project (Vercel dashboard → Storage → Create
# Database → Postgres → Connect to Project). For local dev, pull it down with
# `vercel env pull .env.local`, or point at your own local/hosted Postgres instance.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret used to sign login JWTs. Falls back to an insecure default in src/lib/auth.ts
# if unset — set a real value in production.
JWT_SECRET="change-me-to-a-long-random-string"
