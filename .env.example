# Supabase → Project Settings → Database → Connection string.
# For now, just this one is required to build/deploy — add it in
# Vercel → Settings → Environment Variables (not auto-injected).
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# Once you're ready to fully wire up the database, switch DATABASE_URL to the
# pooled (port 6543, add ?pgbouncer=true) connection string instead, add this
# DIRECT_URL var with the direct (port 5432) string, and uncomment the
# directUrl line in prisma/schema.prisma. See the comment there for why.
# DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# Secret used to sign login JWTs. Falls back to an insecure default in src/lib/auth.ts
# if unset — set a real value in production.
JWT_SECRET="change-me-to-a-long-random-string"
