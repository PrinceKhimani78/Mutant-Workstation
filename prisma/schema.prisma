datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer/Supavisor, port 6543) — used for normal app
  // queries. Serverless functions open a fresh connection per invocation;
  // without pooling this exhausts Postgres' connection limit almost immediately.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — used only for schema changes (prisma db
  // push / migrate). The pooler's transaction mode doesn't reliably support
  // the DDL Prisma needs for those.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          String    @default("Developer") // Owner, Sales Manager, Sales Executive, Project Manager, Developer, etc.
  department    String?
  avatarUrl     String?
  phone         String?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedLeads     Lead[]           @relation("AssignedSales")
  assignedProjects  ProjectMember[]
  assignedTasks     Task[]           @relation("TaskAssignee")
  createdTasks      Task[]           @relation("TaskCreator")
  timeLogs          TimeLog[]
  leaveRequests     LeaveRequest[]   @relation("EmployeeLeaves")
  approvedLeaves    LeaveRequest[]   @relation("ApprovedLeaves")
  auditLogs         AuditLog[]
  comments          Comment[]
  activeTimer       ActiveTimer?
}

model Lead {
  id                  String   @id @default(uuid())
  name                String
  company             String
  email               String
  phone               String?
  whatsapp            String?
  website             String?
  linkedin            String?
  country             String?
  industry            String?
  source              String   // Upwork Profile 1 Prince, Upwork Profile 2 Het, Upwork Profile 3 Aman, LinkedIn, Cold Email, Website, Referral, Instagram, Facebook, Local, Other
  assignedSalespersonId String?
  assignedSalesperson   User?    @relation("AssignedSales", fields: [assignedSalespersonId], references: [id])
  stageId             String
  stage               PipelineStage @relation(fields: [stageId], references: [id])
  estimateType        String   @default("Fixed") // Fixed or Hourly — same idea as Client.billingType
  budget              Float?   // used when estimateType = Fixed
  hourlyRate          Float?   // used when estimateType = Hourly
  estimatedWeeklyHours Float?  // used when estimateType = Hourly
  probability         Int?     @default(50)
  expectedCloseDate   DateTime?
  proposalValue       Float?
  notes               String?
  isGhosted           Boolean  @default(false)
  lastContactedAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  activities          LeadActivity[]
  tags                Tag[]              @relation("LeadTags")
  customFieldValues   CustomFieldValue[]
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())

  leads     Lead[]   @relation("LeadTags")
}

// User-defined fields attached to leads/contacts. `options` holds a JSON array of
// strings for the selection-based types (dropdown/radio/checkbox); null otherwise.
model CustomFieldDefinition {
  id        String   @id @default(uuid())
  name      String
  type      String   // single_line, multi_line, textbox_list, number, monetary, phone, email, url, dropdown_single, dropdown_multi, radio, checkbox
  options   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  values    CustomFieldValue[]
}

// One value per (field, lead). `value` is JSON-encoded so it can hold a string,
// number, boolean, or string[] depending on the field's type.
model CustomFieldValue {
  id      String                 @id @default(uuid())
  fieldId String
  field   CustomFieldDefinition  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  leadId  String
  lead    Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value   String?

  @@unique([fieldId, leadId])
}

// User-configurable pipeline columns (Kanban stages). Deleting a stage that still
// has leads in it is blocked by the API unless the caller reassigns them first.
model PipelineStage {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  color     String   @default("#fc6203")
  createdAt DateTime @default(now())

  leads     Lead[]
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String   // Call, Email, Meeting, Note, StatusChange
  title       String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())
}

model Client {
  id                String   @id @default(uuid())
  company           String
  contactPerson     String
  // Not unique: the same contact email legitimately shows up across more than
  // one client record (shared agency/Upwork contact, multiple engagements
  // with the same person, etc.) — a hard DB constraint here was blocking
  // real client creation.
  email             String
  phone             String?
  billingInformation String?
  services          String?  // JSON string or comma separated
  source            String?  // Upwork Profile 1 Prince, Upwork Profile 2 Het, Upwork Profile 3 Aman, B2B Partner, Referral, LinkedIn, Direct, Other
  currency          String   @default("USD") // USD or INR
  billingType       String   @default("Retainer") // Retainer or Hourly
  retainerValue     Float    @default(0)
  hourlyRate        Float?
  weeklyHourLimit   Float?
  renewalDate       DateTime?
  assignedPmId      String?
  status            String   @default("Active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  projects          Project[]
  invoices          Invoice[]
  timeLogs          TimeLog[]
}

model Project {
  id             String    @id @default(uuid())
  name           String
  description    String?
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  service        String?
  department     String?
  budget         Float?
  deadline       DateTime?
  priority       String    @default("Medium") // Low, Medium, High, Urgent
  status         String    @default("In Progress") // Planning, In Progress, On Hold, Completed
  progress       Int       @default(0) // 0-100
  estimatedHours Float?
  timeSpent      Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tasks          Task[]
  members        ProjectMember[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?  @default("Member")

  @@unique([projectId, userId])
}

model Task {
  id             String    @id @default(uuid())
  title          String
  description    String?
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById    String?
  createdBy      User?     @relation("TaskCreator", fields: [createdById], references: [id])
  dueDate        DateTime?
  priority       String    @default("Medium") // Low, Medium, High, Urgent
  status         String    @default("To Do") // To Do, In Progress, Review, Completed
  estimatedHours Float?    @default(0)
  timeLogged     Float     @default(0)
  labels         String?   // JSON array string
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  timeLogs       TimeLog[]
  comments       Comment[]
  activeTimers   ActiveTimer[]
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

// One running stopwatch per user (ClickUp-style start/stop timer). Deleted on stop,
// at which point a TimeLog row is written with the computed duration.
model ActiveTimer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
}

model TimeLog {
  id          String   @id @default(uuid())
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  // Direct client hour logging (no task/project required) — for hourly/B2B
  // clients where the work isn't tracked through a formal project structure.
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  hours       Float
  description String?
  date        DateTime @default(now())
  isBillable  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Employee {
  id               String   @id @default(uuid())
  userId           String   @unique
  position         String
  department       String
  skills           String?
  salary           Float?
  joiningDate      DateTime @default(now())
  leaveBalance     Int      @default(24)
  emergencyContact String?
  status           String   @default("Active")
  createdAt        DateTime @default(now())
}

model LeaveRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("EmployeeLeaves", fields: [userId], references: [id])
  type        String    // Paid, Casual, Sick, Unpaid
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String    @default("Pending") // Pending, Approved, Rejected
  approvedById String?
  approvedBy  User?     @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  createdAt   DateTime  @default(now())
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  currency      String    @default("USD") // USD or INR
  amount        Float
  tax           Float     @default(0)
  discount      Float     @default(0)
  status        String    @default("Draft") // Draft, Sent, Paid, Overdue, Cancelled
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  itemsJson     String?   // JSON list of line items
  createdAt     DateTime  @default(now())
}

model KnowledgeArticle {
  id        String   @id @default(uuid())
  title     String
  category  String   // SOP, Template, Guide, Policy
  content   String
  tags      String?
  author    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id        String   @id @default(uuid())
  title     String
  type      String   // Logo, Presentation, Video, Document, Design
  fileUrl   String
  category  String
  client    String?
  tags      String?
  createdAt DateTime @default(now())
}

model Workflow {
  id             String   @id @default(uuid())
  name           String
  trigger        String   // Lead Won, Project Completed, Invoice Paid, Task Overdue
  conditionsJson String?
  actionsJson    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String?
  detailsJson String?
  ipAddress   String?
  timestamp   DateTime @default(now())
}
